{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "outDir": "../dist",
    "noEmit": false,
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@server/*": ["*"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": [
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.spec.ts",
    "test/**"
  ]
}
